{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "moduleResolution": "node",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "resources/ts/*"
            ],
            "@plugins/*": [
                "resources/ts/plugins/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        ".vscode",
        ".idea"
    ]
}
